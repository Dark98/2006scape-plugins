// @name Auto Runner
// @author 2006Scape
// @version 1.0.0
// @minApi 1.0.0
// @desc Automatically runs to a selected destination using smart pathing and the F2P road network.
// @type script
// @config destination|Destination|choice|Lumbridge Castle|Lumbridge Castle,Lumbridge Coop,Lumbridge Cows,Al-Kharid Bank,Draynor Bank,Port Sarim,Rimmington,Falador East Bank,Falador West Bank,Barbarian Village,Edgeville Bank,Varrock Square,Varrock West Bank,Varrock East Bank,Taverley
// @config stopOnArrival|Stop on Arrival|bool|true
// @config showDebugPath|Debug Path Overlay|bool|true

String destination = "Lumbridge Castle";
boolean stopOnArrival = true;
boolean showDebugPath = true;

int targetX = 3222;
int targetY = 3218;

void resolveDestination() {
    if (destination == "Lumbridge Castle") {
        targetX = 3222;
        targetY = 3218;
    } else if (destination == "Lumbridge Coop") {
        targetX = 3236;
        targetY = 3293;
    } else if (destination == "Lumbridge Cows") {
        targetX = 3250;
        targetY = 3267;
    } else if (destination == "Al-Kharid Bank") {
        targetX = 3270;
        targetY = 3167;
    } else if (destination == "Draynor Bank") {
        targetX = 3092;
        targetY = 3243;
    } else if (destination == "Port Sarim") {
        targetX = 3028;
        targetY = 3217;
    } else if (destination == "Rimmington") {
        targetX = 2957;
        targetY = 3214;
    } else if (destination == "Falador East Bank") {
        targetX = 3013;
        targetY = 3355;
    } else if (destination == "Falador West Bank") {
        targetX = 2946;
        targetY = 3368;
    } else if (destination == "Barbarian Village") {
        targetX = 3080;
        targetY = 3420;
    } else if (destination == "Edgeville Bank") {
        targetX = 3094;
        targetY = 3492;
    } else if (destination == "Varrock Square") {
        targetX = 3212;
        targetY = 3428;
    } else if (destination == "Varrock West Bank") {
        targetX = 3185;
        targetY = 3436;
    } else if (destination == "Varrock East Bank") {
        targetX = 3253;
        targetY = 3420;
    } else if (destination == "Taverley") {
        targetX = 2895;
        targetY = 3440;
    }
}

void onConfigChanged(key, value) {
    if (key == "destination") {
        destination = value;
        resolveDestination();
    } else if (key == "stopOnArrival") {
        stopOnArrival = value;
    } else if (key == "showDebugPath") {
        showDebugPath = value;
    }
}

void onStart(ctx) {
    resolveDestination();
    script.setStatus("Running to " + destination);
    if (ctx != null) {
        ctx.sendClientMessage("Auto Runner started -> " + destination + " (" + targetX + ", " + targetY + ")");
    }
}

void onStop(ctx) {
    if (ctx != null) {
        ctx.sendClientMessage("Auto Runner stopped.");
    }
}

int loop(ctx) {
    if (!ctx.isLoggedIn()) {
        script.setStatus("Waiting for login");
        return 1000;
    }

    if (ctx.canContinueDialogue()) {
        ctx.continueDialogue();
        return ctx.randomDelay(600, 900);
    }

    ctx.ensureRunEnabled(20);

    if (script.isStuck(20000)) {
        script.setStatus("Watchdog: recovering");
        script.clearWait();
        script.resetWatchdog();
    }

    if (ctx.isAt(targetX, targetY, 4)) {
        script.setStatus("Arrived at " + destination);
        if (stopOnArrival) {
            ctx.sendClientMessage("Auto Runner arrived at " + destination + "!");
            return -1;
        }
        return 1500;
    }

    script.setStatus("Running to " + destination);
    ctx.walkToSmartOrOpenDoors(targetX, targetY);
    return ctx.randomDelay(1000, 1400);
}

void onRenderOverlay(ctx, g) {
    int x = 8;
    int y = 28;
    int w = 220;
    int h = 88;

    g.drawPanel(x, y, w, h, "Auto Runner");

    int lineY = y + 32;
    g.drawString("Status: " + script.getStatus(), x + 8, lineY, RSColors.WHITE, true);
    lineY += 14;

    g.drawString("Target: " + destination, x + 8, lineY, RSColors.CYAN, true);
    lineY += 14;

    if (ctx != null && ctx.isLoggedIn()) {
        int dist = ctx.distanceTo(targetX, targetY);
        g.drawString("Distance: " + dist + " tiles", x + 8, lineY, RSColors.GREEN, true);
    } else {
        g.drawString("Runtime: " + script.getFormattedRuntime(), x + 8, lineY, RSColors.YELLOW, true);
    }

    g.drawTileOverlay(targetX, targetY, 0x00ff00, destination);

    if (showDebugPath && ctx != null) {
        g.drawPathOverlay(ctx.getLastComputedPath(), 0x00ffff);
    }
}
